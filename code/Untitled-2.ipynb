   "source": [
    "def wmean(g, col):\n",
    "    g = g.dropna(subset=[col, 'W_WEIGHT'])\n",
    "    return np.average(g[col], weights=g['W_WEIGHT'])\n",
    "\n",
    "res = pd.DataFrame({\n",
    "    name: {c: wmean(g, q) for c, g in sea.groupby('B_COUNTRY_ALPHA')}\n",
    "    for q, name in items.items()\n",
    "})\n",
    "res.index = res.index.map(country_map)\n",
    "res.round(3)"
   ]
  },
