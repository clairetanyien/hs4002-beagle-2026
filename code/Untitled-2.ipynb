    "\n",
    "import pandas as pd\n",
    "import numpy as np\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "600a3dd4",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Load raw dataset \n",
    "\n",
    "df_raw = pd.read_csv('../data/raw/WVS_Survey_Trimmed.csv', low_memory=False)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "29fbf6b1",
   "metadata": {},
